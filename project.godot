; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.

config_version=5

[application]

config/name="Sons of Hellas"
config/description="Turn-Based Grand Strategy Campaign Map for Mobile (Godot 4)"
run/main_scene="res://scenes/TitleScreen.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
run/max_fps=60

[audio]

driver/mix_rate=48000

[autoload]

TurnManager="*res://scripts/core/TurnManager.gd"
CampaignManager="*res://scripts/core/CampaignManager.gd"
SaveManager="*res://scripts/core/SaveManager.gd"
AudioManager="*res://scripts/core/AudioManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=1
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12, 0.12, 0.14, 1)
