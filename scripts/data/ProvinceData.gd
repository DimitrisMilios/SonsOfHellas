class_name ProvinceData
extends Resource

@export_group("Identity")
@export var province_id: String = ""
@export var province_name: String = ""
@export var owner_faction_id: String = ""
@export_range(1, 5, 1) var settlement_tier: int = 1

@export_group("Social & Public Order")
@export_range(-100.0, 100.0, 1.0) var public_order: float = 100.0
@export_range(-20.0, 20.0, 0.5) var public_order_trend: float = 0.0

@export_group("Economy & Growth")
@export_range(0.0, 2000.0, 10.0) var base_tax: float = 100.0
@export_range(0.0, 100.0, 1.0) var growth_rate: float = 5.0
@export var current_population: int = 1000
@export var growth_points_accumulated: float = 0.0
@export var growth_threshold_for_upgrade: float = 100.0

@export_group("Infrastructure")
@export_range(1, 8, 1) var max_building_slots: int = 3
@export var building_slots: Array[BuildingData] = []

@export_group("Defense & Connections")
@export var garrison_units: Array[UnitData] = []
@export var adjacent_province_ids: Array[String] = []
@export var map_position: Vector2 = Vector2.ZERO

## Calculates total revenue generated by base tax and constructed buildings.
func calculate_total_tax() -> float:
	var total: float = base_tax
	for building: BuildingData in building_slots:
		if building != null:
			total += building.tax_bonus
	return total

## Calculates total public order modifier applied per turn.
func calculate_public_order_delta() -> float:
	var delta: float = public_order_trend
	for building: BuildingData in building_slots:
		if building != null:
			delta += building.public_order_bonus
	# High tax penalty
	if base_tax > 200.0:
		delta -= (base_tax - 200.0) * 0.02
	return delta

## Simulates turn progression for growth and public order.
func process_turn_progression() -> void:
	# Public Order update
	public_order = clampf(public_order + calculate_public_order_delta(), -100.0, 100.0)
	
	# Growth update
	var net_growth: float = growth_rate
	for building: BuildingData in building_slots:
		if building != null:
			net_growth += building.growth_bonus
	growth_points_accumulated += net_growth

## Check if building can be added
func can_add_building() -> bool:
	return building_slots.size() < max_building_slots

## Attempt to add building to province
func add_building(building: BuildingData) -> bool:
	if can_add_building() and building != null:
		building_slots.append(building)
		return true
	return false

## Checks adjacency with target province ID
func is_adjacent_to(target_id: String) -> bool:
	return adjacent_province_ids.has(target_id)
